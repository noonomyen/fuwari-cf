---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="404 - Page not found" description="The page you requested could not be found.">
	<div class="card-base px-8 py-12 text-center">
		<div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--primary)]/15 text-[var(--primary)]">
			<Icon name="material-symbols:error-outline-rounded" class="text-[2rem]" />
		</div>
		<h1 class="mb-3 text-3xl font-bold text-black/90 dark:text-white/90">404</h1>
		<div class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">Page not found</div>
		<div class="text-center text-neutral-400 mb-2.5 transition">
			The link may be broken, or the page may have been moved.
		</div>
	</div>
</MainGridLayout>
